<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rule for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/clearoo.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/clearoo.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
